# Set a real password before running. This is used by both the minio
# service and minio-init (Docker Compose substitutes ${MINIO_ROOT_PASSWORD}
# into both automatically from this one file).
MINIO_ROOT_PASSWORD=ENTER YOUR PASSWORD

# Must be the Docker host's real LAN IP or hostname, not "localhost" --
# unless you'll only ever open the web app from the Docker host itself.
# This gets baked into the web app at build time, so "localhost" would
# resolve to whichever machine the browser runs on, not the Docker host.
# Example: PROXYNEXUS_COLLECTIONS_URL=http://192.168.1.50:9000/proxynexus-collections
PROXYNEXUS_COLLECTIONS_URL=http://IP or HOSTNAME:9000/proxynexus-collections
